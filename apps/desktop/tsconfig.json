{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": { "@/*": ["./src/renderer/*"] },
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "veldorajs/node"]
  },
  "include": ["vite.config.ts", "src"]
}
